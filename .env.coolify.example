# MailOne Coolify Deployment Environment Variables Example
# Most of the required variables (SERVICE_FQDN_*, SERVICE_PASSWORD_*) 
# will be automatically generated and provided by Coolify.

# ========================================
# Application Settings
# ========================================
# The domain the application is served on (for auth cookies)
COOKIE_DOMAIN=example.com

# ========================================
# OAuth Credentials (Required)
# ========================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ========================================
# AI / Embedding Providers
# ========================================
# OpenRouter (Required for some AI features)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI (Required if using OpenAI models directly)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini

# Optional AI Providers
# GROQ_API_KEY=your_groq_api_key
# PERPLEXITY_API_KEY=your_perplexity_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# ========================================
# Email Settings
# ========================================
# Resend API Key for sending emails
RESEND_API_KEY=your_resend_api_key_here

# ========================================
# Database / Infrastructure (Optional Overrides)
# ========================================
# These are automatically handled by Coolify, but you can override the defaults if needed
POSTGRES_USER=postgres
POSTGRES_DB=mailone
REDIS_TOKEN=valkey
